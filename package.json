{
  "name": "Wuzz",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "android:staging": "ENVFILE=.env.staging react-native run-android --mode=stagingDebug --appId com.wuzz.staging",
    "android:production": "ENVFILE=.env.production react-native run-android --mode=productionDebug --appId com.wuzz",
    "android:staging:release": "ENVFILE=.env.staging react-native run-android --mode=stagingRelease --appId com.wuzz.staging",
    "android:production:release": "ENVFILE=.env.production react-native run-android --mode=productionRelease --appId com.wuzz",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios --scheme Staging",
    "ios:production": "ENVFILE=.env.production react-native run-ios --scheme Production",
    "ios:staging:release": "ENVFILE=.env.staging react-native run-ios --scheme Staging --mode Release",
    "ios:production:release": "ENVFILE=.env.production react-native run-ios --scheme Production --mode Release",
    "run:staging": "ENVFILE=.env.staging react-native run-ios --scheme Staging",
    "run:production": "ENVFILE=.env.production react-native run-ios --scheme Production",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "start": "react-native start",
    "test": "jest"
  },
