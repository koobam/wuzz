{
  "name": "@wuzz/station",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "station"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "android": "react-native run-android",
    "android:staging": "cross-env ENVFILE=.env.staging react-native run-android --mode=stagingDebug --appId com.wuzz.station.staging",
    "android:production": "cross-env ENVFILE=.env.production react-native run-android --mode=productionDebug --appId com.wuzz.station",
    "ios": "react-native run-ios",
    "ios:staging": "cross-env ENVFILE=.env.staging react-native run-ios --scheme Staging",
    "ios:production": "cross-env ENVFILE=.env.production react-native run-ios --scheme Production",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@react-navigation/native": "7.3.4",
    "@react-navigation/native-stack": "7.17.6",
    "@react-navigation/bottom-tabs": "7.18.3",
    "@react-navigation/elements": "2.9.26",
    "@tanstack/react-query": "5.101.2",
    "@wuzz/api": "workspace:*",
    "@wuzz/native": "workspace:*",
    "@wuzz/ui": "workspace:*",
    "query-string": "7.1.3",
    "react": "19.1.1",
    "react-native": "0.82.0",
    "react-native-config": "1.6.1",
    "react-native-device-info": "14.1.1",
    "react-native-gesture-handler": "2.32.0",
    "react-native-mmkv": "3.3.3",
    "react-native-network-info": "5.2.2",
    "react-native-nitro-fetch": "1.5.0",
    "react-native-nitro-modules": "0.35.10",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.25.2"
  },
  "devDependencies": {
    "babel-plugin-module-resolver": "5.0.3",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.0",
    "@react-native/eslint-config": "0.82.0",
    "@react-native/metro-config": "0.82.0",
    "@react-native/typescript-config": "0.82.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.17",
    "@types/react-test-renderer": "19.1.0",
    "cross-env": "10.1.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
