{
  "extends": ["@react-native/typescript-config", "../../tsconfig.base.json"],
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@core/*": ["src/core/*"],
      "@features/*": ["src/features/*"],
      "@pages/*": ["src/pages/*"],
      "@navigation/*": ["src/navigation/*"],
      "@services/*": ["src/services/*"]
    }
  }
}
