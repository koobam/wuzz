// tmp.xcconfig is generated by scheme Pre-action from .env.staging (Staging) or .env.production (Production)
// Defaults when tmp is missing; tmp overrides with env values for plist & icon
APP_VERSION = 1.0
APP_DISPLAY_NAME = Station
APP_ICON_NAME = AppIcon
IOS_BUNDLE_ID_SUFFIX =

#include? "tmp.xcconfig"

ASSETCATALOG_COMPILER_APPICON_NAME = $(APP_ICON_NAME)
