{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.md", "!{projectRoot}/.env*"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      { "env": "VITE_API_URL" },
      { "env": "VITE_SENTRY_DSN" }
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": ["^typecheck"],
      "inputs": ["default", "^default"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "dev": {
      "continuous": true
    },
    "preview": {
      "continuous": true,
      "dependsOn": ["build"]
    }
  },
  "analytics": false
}
